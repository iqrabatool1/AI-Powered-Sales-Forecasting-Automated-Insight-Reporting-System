# Environment variables (contains API key - never push this)
.env

# Python cache
__pycache__/
*.pyc

# Large data files (Rossmann CSVs are big - optional to exclude)
data/*.csv

# Trained model (optional - can be large; remove this line if you want to include it)
src/*.pkl

# Jupyter checkpoints
.ipynb_checkpoints/

# Generated reports (optional - remove this line if you want them tracked)
reports/